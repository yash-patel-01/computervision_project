# Data directories (do not commit large datasets)
# Original raw datasets - Part 1: Player & Ball Detection
data/jersey-2023/
data/tracking-2023/

# Generated YOLO dataset (symlinks/copies)
data/yolo_dataset_full_unique/

# Large COCO annotation files (too big for GitHub)
data/coco_train.json
data/coco_test.json

# Any nested image/label folders under data
data/**/images/
data/**/labels/

# Part 2: Jersey Number Recognition - workspace folder
# Excludes downloaded datasets, generated crops, annotations, and model weights
# The notebook (Jersey-Number_Recognition.ipynb) is tracked in git
SoccerNetJersey/

# Ultralytics/YOLO training artifacts (large files)
# Keep best.pt (6MB - critical trained weights), exclude other checkpoints
tracking_baseline/train/runs/yolo/**/weights/last.pt
tracking_baseline/train/runs/yolo/**/weights/epoch*.pt
tracking_baseline/train/runs/yolo/**/labels.jpg
tracking_baseline/train/runs/yolo/**/train_batch*.jpg
tracking_baseline/train/runs/yolo/**/val_batch*.jpg
tracking_baseline/train/runs/yolo/**/*.png

# Training logs - keep small result logs, exclude large verbose logs
# Small logs with training summaries are kept (< 100KB)
# Exclude only if they grow too large in future iterations

# Temporary/intermediate config files
data_config_yolo.yaml
heartbeat.json

# Local Ultralytics artifacts (created during training/inference)
/runs/

# Downloaded pretrained weights (not our trained models)
# yolov8n.pt used by both projects for fine-tuning
# yolov8n-pose.pt used by jersey recognition for pose estimation
yolov8n.pt
yolov8n-pose.pt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Layer visualization outputs (generated PNGs)
layer_visualizations/
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Model checkpoints (large binary files)
# Keep: best.pt (trained YOLO weights), small config/metric JSONs, CSVs, logs
# Exclude: Large intermediate checkpoints (.pth for PyTorch, .h5 for Keras, .ckpt for TensorFlow)
*.pth
*.h5
*.ckpt
